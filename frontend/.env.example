# Copy thành .env.local rồi chỉnh giá trị.

# Địa chỉ backend FastAPI (không kèm /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nhóm API gọi backend thật, cách nhau bởi dấu phẩy; nhóm không liệt kê dùng mock (lib/mocks).
# Các nhóm: me, notifications, overview, cv, gap, optimizer, interview, feedback, sharing, settings, advisor, messages
# "all" = gọi backend cho tất cả. Để trống = các nhóm tài nguyên dùng mock.
# Login, logout và hồ sơ /me luôn gọi backend thật, không phụ thuộc danh sách này.
NEXT_PUBLIC_LIVE_APIS=

# Chức năng ngoài phạm vi Gate 1, mặc định tắt (xem lib/features.ts)
NEXT_PUBLIC_FEATURE_MULTI_JD=false
NEXT_PUBLIC_FEATURE_VOICE_INTERVIEW=false
NEXT_PUBLIC_FEATURE_JOB_URL_IMPORT=false
NEXT_PUBLIC_FEATURE_DRIVE_IMPORT=false
NEXT_PUBLIC_FEATURE_DATA_ACTIONS=false
NEXT_PUBLIC_FEATURE_ADVISOR_CHAT=false
NEXT_PUBLIC_FEATURE_PROGRESS_PDF=false

# Kịch bản mock: default | new_student (sinh viên mới, chưa có dữ liệu)
NEXT_PUBLIC_MOCK_SCENARIO=default
