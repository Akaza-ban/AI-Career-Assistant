# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Groq / OpenRouter / OpenAI) ----
# Lựa chọn provider: "groq", "openrouter", hoặc "openai"
LLM_PROVIDER=groq

# Điền API key tương ứng với provider bạn chọn:
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Model name:
# - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# - OpenRouter: meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
# - OpenAI: gpt-4o-mini, gpt-4o
MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_BASE_URL=

# ---- LangSmith Tracing (AI Logs — Deliverable #4) ----
# Bật tracing và điền 3 biến môi trường LangSmith:
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai20k-p131
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- App Config ----
APP_NAME="Trợ lý nghề nghiệp X"
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Qdrant:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (Next.js) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
