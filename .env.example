# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Groq / OpenRouter / OpenAI / Gemini) ----
# Lựa chọn provider: "groq", "openrouter", hoặc "openai"
# Key để trống = không gọi LLM, agent dùng quy tắc dự phòng (rule-based fallback).
LLM_PROVIDER=groq

# Điền API key tương ứng với provider bạn chọn:
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Model name:
# - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b
# - OpenRouter: meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
# - OpenAI: gpt-4o-mini, gpt-4o
# - Gemini: gemini-2.5-flash, gemini-2.5-flash-lite (xem cấu hình Gemini bên dưới)
MODEL_NAME=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
LLM_BASE_URL=https://api.groq.com/openai/v1

# Dùng Gemini (Google AI Studio) qua endpoint tương thích OpenAI:
# lấy key tại https://aistudio.google.com/apikey rồi đặt 4 biến như sau.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<gemini_api_key>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-2.5-flash

# ---- LangSmith Tracing (AI Logs — Deliverable #4) ----
# Chỉ bật (true) khi đã có LANGCHAIN_API_KEY thật; key mẫu sẽ gây lỗi 403 liên tục trong log.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai20k-p131
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- App Config ----
APP_NAME="Trợ lý nghề nghiệp X"
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- File uploads (CV gốc của sinh viên) ----
UPLOAD_DIR=./data/uploads
# Tạo nhóm SV giả định do cố vấn demo phụ trách khi khởi động (true/false)
SEED_DEMO_COHORT=true

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Qdrant:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (Next.js) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
